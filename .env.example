# Ethereum mainnet archive RPC used by the Anvil fork (required)
ETH_RPC_URL=
# Optional: pin the fork block for reproducible demos
FORK_BLOCK=
# Optional: agent model (default claude-sonnet-5-5).
AGENT_MODEL=
# Optional: Claude API key for the agent. When set it takes precedence over the Claude Code login
# (and CLAUDE_CODE_OAUTH_TOKEN); leave empty to use the login.
ANTHROPIC_API_KEY=
# Optional: Avalanche C-Chain RPC the Avalanche fork starts from (default: public api.avax.network)
AVAX_RPC_URL=
# Optional: Tokenomist API key for token unlocks (list_unlocks). Agent-only; never sent to the browser.
TOKENOMIST_API_KEY=
# Optional: ElevenLabs key for spoken replies (agent POST /tts). Agent-only; never sent to the browser.
ELEVENLABS_API_KEY=
# Optional: ElevenLabs voice id (default Jessica, cgSgspJ2msm6clMCkdW9)
ELEVENLABS_VOICE_ID=

# --- docker compose (behind Caddy on the external "caddy" network) ---
# Domain Caddy serves; services live under /lazy-agent, /sandbox-eth, /sandbox-avax, /sandbox-faucet
DOMAIN=
# Claude Code auth inside the container (run `claude setup-token` and paste the token)
CLAUDE_CODE_OAUTH_TOKEN=
# Comma-separated origins allowed to call the agent and faucet (the deployed wallet's URL)
# WALLET_ORIGINS=https://wallet.example.com
